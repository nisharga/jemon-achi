# Copy to .env.local and fill in. Only NEXT_PUBLIC_* vars are exposed to the browser.

# Backend REST base (login, profile, all admin data)
# e.g. https://api.example.com/api/v1  (NEXT_PUBLIC_BASE_SERVER_API also accepted)
NEXT_PUBLIC_API_BASE_URL=

# Canonical site URL (metadataBase, sitemap)
NEXT_PUBLIC_SITE_DOMAIN=http://localhost:3000

# File upload API key (used by admin media uploads)
NEXT_PUBLIC_FILE_UPLOAD_API_KEY=

# Plausible site-specific script URL (https://plausible.io/js/pa-XXXXX.js); empty = analytics off
NEXT_PUBLIC_PLAUSIBLE_SRC=
